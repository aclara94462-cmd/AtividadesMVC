@model IEnumerable<CursoMVC.Models.Curso>
@{ ViewData["Title"] = "Cursos"; ViewData["Site"] = "Cursos presenciais"; ViewData["Controller"] = "Curso"; }
<h1>Cursos presenciais</h1><table class="table table-striped"><thead><tr><th>Curso</th><th>Carga horária</th><th>Modalidade</th><th>Vagas</th><th>Valor</th><th>Situação</th></tr></thead><tbody>@foreach (var c in Model) { <tr><td>@c.Nome</td><td>@c.CargaHoraria h</td><td>@c.Modalidade</td><td>@c.Vagas</td><td>R$ @c.Valor.ToString("N2")</td><td>@(c.Vagas > 0 ? "Inscrições abertas" : "Turma lotada")</td></tr> }</tbody></table>
@section Menu { <div class="navbar-nav flex-row gap-3"><a class="nav-link text-white" asp-controller="Curso" asp-action="Index">Resumo</a><a class="nav-link text-white" asp-controller="Curso" asp-action="Disponiveis">Disponíveis</a><a class="nav-link text-white" asp-controller="Curso" asp-action="Online">Online</a><a class="nav-link text-white" asp-controller="Curso" asp-action="Presenciais">Presenciais</a></div> }
