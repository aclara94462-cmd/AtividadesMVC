@model IEnumerable<CursoMVC.Models.Curso>

@{
    ViewData["Title"] = "Cursos";
}

<h1>Sistema de Cursos</h1>

<nav>
    <a asp-controller="Curso" asp-action="Index">Todos</a> |
    <a asp-controller="Curso" asp-action="Disponiveis">Disponíveis</a> |
    <a asp-controller="Curso" asp-action="Online">Online</a> |
    <a asp-controller="Curso" asp-action="Presenciais">Presenciais</a>
</nav>

<br />

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Carga Horária</th>
            <th>Modalidade</th>
            <th>Vagas</th>
            <th>Valor</th>
            <th>Situação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var curso in Model)
        {
            <tr>
                <td>@curso.Nome</td>
                <td>@curso.CargaHoraria horas</td>
                <td>@curso.Modalidade</td>
                <td>@curso.Vagas</td>
                <td>@curso.Valor.ToString("C")</td>
                <td>
                    @(curso.Vagas > 0
                        ? "Inscrições abertas"
                        : "Turma lotada")
                </td>
            </tr>
        }
    </tbody>
</table>
