@model IEnumerable<CursoMVC.Models.Curso>
@{ ViewData["Title"] = "Cursos"; ViewData["Site"] = "Sistema de Cursos"; ViewData["Controller"] = "Curso"; }
<h1>Sistema de Cursos</h1><table class="table table-striped"><thead><tr><th>Curso</th><th>Carga horária</th><th>Modalidade</th><th>Vagas</th><th>Valor</th><th>Situação</th></tr></thead><tbody>@foreach (var c in Model) { <tr><td>@c.Nome</td><td>@c.CargaHoraria h</td><td>@c.Modalidade</td><td>@c.Vagas</td><td>R$ @c.Valor.ToString("N2")</td><td>@(c.Vagas > 0 ? "Inscrições abertas" : "Turma lotada")</td></tr> }</tbody></table>
<h2>Resumo</h2><p><strong>Total:</strong> @Model.Count()</p><p><strong>Disponíveis:</strong> @Model.Count(x => x.Vagas > 0)</p><p><strong>Lotados:</strong> @Model.Count(x => x.Vagas == 0)</p><p><strong>Online:</strong> @Model.Count(x => x.Modalidade == "Online")</p><p><strong>Presenciais:</strong> @Model.Count(x => x.Modalidade == "Presencial")</p>@section Menu { <div class="navbar-nav flex-row gap-3"><a class="nav-link text-white" asp-controller="Curso" asp-action="Index">Resumo</a><a class="nav-link text-white" asp-controller="Curso" asp-action="Disponiveis">Disponíveis</a><a class="nav-link text-white" asp-controller="Curso" asp-action="Online">Online</a><a class="nav-link text-white" asp-controller="Curso" asp-action="Presenciais">Presenciais</a></div> }
