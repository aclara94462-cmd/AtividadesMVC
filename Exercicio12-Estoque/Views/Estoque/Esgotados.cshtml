@model IEnumerable<EstoqueMVC.Models.Produto>
@{ ViewData["Title"] = "Estoque"; ViewData["Site"] = "Produtos esgotados"; ViewData["Controller"] = "Estoque"; }
<h1>Produtos esgotados</h1><table class="table table-striped"><thead><tr><th>Nome</th><th>Categoria</th><th>Estoque</th><th>Mínimo</th><th>Preço</th><th>Status</th></tr></thead><tbody>@foreach (var p in Model) { var status = p.Estoque == 0 ? "ESGOTADO" : p.Estoque <= p.EstoqueMinimo ? "ESTOQUE BAIXO" : "ESTOQUE NORMAL"; <tr><td>@p.Nome</td><td>@p.Categoria</td><td>@p.Estoque</td><td>@p.EstoqueMinimo</td><td>R$ @p.Preco.ToString("N2")</td><td>@status</td></tr> }</tbody></table>
@section Menu { <div class="navbar-nav flex-row gap-3"><a class="nav-link text-white" asp-controller="Estoque" asp-action="Index">Lista geral</a><a class="nav-link text-white" asp-controller="Estoque" asp-action="Baixo">Estoque baixo</a><a class="nav-link text-white" asp-controller="Estoque" asp-action="Esgotados">Esgotados</a><a class="nav-link text-white" asp-controller="Estoque" asp-action="Alertas">Alertas</a></div> }
