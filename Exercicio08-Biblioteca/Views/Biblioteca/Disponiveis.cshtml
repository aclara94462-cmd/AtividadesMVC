@model IEnumerable<BibliotecaMVC.Models.Livro>
@{ ViewData["Title"] = "Disponíveis"; ViewData["Site"] = "Biblioteca"; ViewData["Controller"] = "Biblioteca"; }
<h1>Livros disponíveis</h1><ul>@foreach (var livro in Model) { <li>@livro.Titulo - @livro.Autor</li> }</ul>
@section Menu { <div class="navbar-nav flex-row gap-3"><a class="nav-link text-white" asp-controller="Biblioteca" asp-action="Index">Livros</a><a class="nav-link text-white" asp-controller="Biblioteca" asp-action="Disponiveis">Disponíveis</a></div> }
