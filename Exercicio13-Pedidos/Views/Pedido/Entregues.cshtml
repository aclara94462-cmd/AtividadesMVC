@model IEnumerable<PedidoMVC.Models.Pedido>
@{ ViewData["Title"] = "Pedidos"; ViewData["Site"] = "Pedidos entregues"; ViewData["Controller"] = "Pedido"; }
<h1>Pedidos entregues</h1><table class="table table-striped"><thead><tr><th>ID</th><th>Cliente</th><th>Produto</th><th>Qtd.</th><th>Unitário</th><th>Total</th><th>Status</th></tr></thead><tbody>@foreach (var p in Model) { <tr><td>@p.Id</td><td>@p.Cliente</td><td>@p.Produto</td><td>@p.Quantidade</td><td>R$ @p.PrecoUnitario.ToString("N2")</td><td>R$ @( (p.Quantidade * p.PrecoUnitario).ToString("N2") )</td><td>@p.Status</td></tr> }</tbody></table>
@section Menu { <div class="navbar-nav flex-row gap-3"><a class="nav-link text-white" asp-controller="Pedido" asp-action="Index">Todos</a><a class="nav-link text-white" asp-controller="Pedido" asp-action="EmPreparo">Em preparo</a><a class="nav-link text-white" asp-controller="Pedido" asp-action="Prontos">Prontos</a><a class="nav-link text-white" asp-controller="Pedido" asp-action="Entregues">Entregues</a><a class="nav-link text-white" asp-controller="Pedido" asp-action="Dashboard">Dashboard</a></div> }
