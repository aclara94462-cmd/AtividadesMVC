@model IEnumerable<FuncionarioMVC.Models.Funcionario>
@{ ViewData["Title"] = "Dashboard"; ViewData["Site"] = "Cadastro de Funcionários"; ViewData["Controller"] = "Funcionario"; }
<h1>Dashboard</h1><p><strong>Total de funcionários:</strong> @Model.Count()</p><p><strong>Ativos:</strong> @Model.Count(x => x.Ativo)</p><p><strong>Inativos:</strong> @Model.Count(x => !x.Ativo)</p><h2>Quantidade por departamento</h2><ul>@foreach (var grupo in Model.GroupBy(x => x.Departamento)) { <li>@grupo.Key: @grupo.Count()</li> }</ul><p><strong>Média salarial:</strong> R$ @Model.Average(x => x.Salario).ToString("N2")</p><p><strong>Maior salário:</strong> R$ @Model.Max(x => x.Salario).ToString("N2")</p><p><strong>Menor salário:</strong> R$ @Model.Min(x => x.Salario).ToString("N2")</p>
@section Menu { <div class="navbar-nav flex-row gap-3"><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Index">Todos</a><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Ativos">Ativos</a><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Inativos">Inativos</a><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Departamento">Departamento</a><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Dashboard">Dashboard</a></div> }
