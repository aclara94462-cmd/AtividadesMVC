@model IEnumerable<FuncionarioMVC.Models.Funcionario>
@{ ViewData["Title"] = "Funcionários"; ViewData["Site"] = "Cadastro de Funcionários"; ViewData["Controller"] = "Funcionario"; }
<h1>Funcionários</h1><table class="table table-striped"><thead><tr><th>Nome</th><th>Cargo</th><th>Departamento</th><th>Salário</th><th>Status</th><th>Faixa salarial</th></tr></thead><tbody>@foreach (var f in Model) { var faixa = f.Salario < 2500 ? "Faixa 1" : f.Salario <= 5000 ? "Faixa 2" : "Faixa 3"; <tr><td>@f.Nome</td><td>@f.Cargo</td><td>@f.Departamento</td><td>R$ @f.Salario.ToString("N2")</td><td>@(f.Ativo ? "Funcionário ativo" : "Funcionário desligado")</td><td>@faixa</td></tr> }</tbody></table>
@section Menu { <div class="navbar-nav flex-row gap-3"><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Index">Todos</a><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Ativos">Ativos</a><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Inativos">Inativos</a><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Departamento">Departamento</a><a class="nav-link text-white" asp-controller="Funcionario" asp-action="Dashboard">Dashboard</a></div> }
