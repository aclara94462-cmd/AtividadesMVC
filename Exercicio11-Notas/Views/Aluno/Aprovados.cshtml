@model IEnumerable<AlunoNotasMVC.Models.Aluno>
@{ ViewData["Title"] = "Notas"; ViewData["Site"] = "Alunos aprovados"; ViewData["Controller"] = "Aluno"; }
<h1>Alunos aprovados</h1><table class="table table-striped"><thead><tr><th>Aluno</th><th>Curso</th><th>Média</th><th>Situação</th></tr></thead><tbody>@foreach (var aluno in Model) { var media = (aluno.Nota1 + aluno.Nota2 + aluno.Nota3) / 3; var situacao = media >= 6 ? "Aprovado" : media >= 4 ? "Recuperação" : "Reprovado"; <tr><td>@aluno.Nome</td><td>@aluno.Curso</td><td>@media.ToString("N1")</td><td>@situacao</td></tr> }</tbody></table>
@section Menu { <div class="navbar-nav flex-row gap-3"><a class="nav-link text-white" asp-controller="Aluno" asp-action="Index">Todos</a><a class="nav-link text-white" asp-controller="Aluno" asp-action="Aprovados">Aprovados</a><a class="nav-link text-white" asp-controller="Aluno" asp-action="Recuperacao">Recuperação</a><a class="nav-link text-white" asp-controller="Aluno" asp-action="Reprovados">Reprovados</a></div> }
